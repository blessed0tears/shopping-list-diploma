@model ShoppingItemFormViewModel

@{
    ViewData["Title"] = "Редактирование товара";
    var itemId = ViewContext.RouteData.Values["id"];
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1 class="h3 mb-4">Редактирование товара</h1>

        <form asp-action="EditItem" asp-route-id="@itemId" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="ShoppingListId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" class="form-select" data-unit-select data-custom-unit-target="#editCustomUnit">
                    <option value="">Не указано</option>
                    @foreach (var unit in ShoppingItemFormViewModel.UnitOptions)
                    {
                        <option value="@unit">@unit</option>
                    }
                </select>
                <span asp-validation-for="Unit" class="text-danger"></span>
            </div>

            <div id="editCustomUnit" class="mb-3 d-none">
                <label asp-for="CustomUnit" class="form-label"></label>
                <input asp-for="CustomUnit" class="form-control" placeholder="Например: коробка" />
                <span asp-validation-for="CustomUnit" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select">
                    @foreach (var category in ShoppingItemFormViewModel.CategoryOptions)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control" rows="3" placeholder="Например: лучше взять по акции"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Details" asp-route-id="@Model.ShoppingListId" class="btn btn-outline-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
