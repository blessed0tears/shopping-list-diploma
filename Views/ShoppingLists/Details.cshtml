@model ShoppingListDetailsViewModel

@{
    ViewData["Title"] = Model.ShoppingList.Name;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="mb-1">@Model.ShoppingList.Name</h1>
        <p class="text-muted mb-0">
            Группа:
            <a asp-controller="ShoppingGroups" asp-action="Details" asp-route-id="@Model.ShoppingList.ShoppingGroupId">@Model.ShoppingList.ShoppingGroup.Name</a>
        </p>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Добавить товар</h2>
    </div>
    <div class="card-body">
        <form asp-action="AddItem" method="post" class="row g-3" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="AddItemForm.ShoppingListId" type="hidden" />

            <div class="col-md-5">
                <label asp-for="AddItemForm.Name" class="form-label"></label>
                <input asp-for="AddItemForm.Name" class="form-control" />
                <span asp-validation-for="AddItemForm.Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="AddItemForm.Quantity" class="form-label"></label>
                <input asp-for="AddItemForm.Quantity" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="AddItemForm.Quantity" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="AddItemForm.Unit" class="form-label"></label>
                <input asp-for="AddItemForm.Unit" class="form-control" placeholder="шт., кг, л" />
                <span asp-validation-for="AddItemForm.Unit" class="text-danger"></span>
            </div>

            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">+</button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Details" asp-route-id="@Model.ShoppingList.Id" asp-route-filter="all" class="btn @(Model.Filter == ShoppingItemFilter.All ? "btn-primary" : "btn-outline-primary")">Все</a>
    <a asp-action="Details" asp-route-id="@Model.ShoppingList.Id" asp-route-filter="active" class="btn @(Model.Filter == ShoppingItemFilter.Active ? "btn-primary" : "btn-outline-primary")">Некупленные</a>
    <a asp-action="Details" asp-route-id="@Model.ShoppingList.Id" asp-route-filter="purchased" class="btn @(Model.Filter == ShoppingItemFilter.Purchased ? "btn-primary" : "btn-outline-primary")">Купленные</a>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">По выбранному фильтру товаров нет.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Статус</th>
                    <th>Товар</th>
                    <th>Количество</th>
                    <th>Добавил</th>
                    <th>Купил</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="@(item.IsPurchased ? "table-success" : string.Empty)">
                        <td>
                            <form asp-action="TogglePurchased" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(item.IsPurchased ? "btn-success" : "btn-outline-secondary")">
                                    @(item.IsPurchased ? "Куплено" : "Отметить")
                                </button>
                            </form>
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.Quantity @item.Unit</td>
                        <td>
                            <div>@(item.CreatedByUser?.DisplayName ?? item.CreatedByUser?.Email ?? "Неизвестно")</div>
                            <div class="small text-muted">@item.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                        </td>
                        <td>
                            @if (item.IsPurchased)
                            {
                                <div>@(item.PurchasedByUser?.DisplayName ?? item.PurchasedByUser?.Email ?? "Неизвестно")</div>
                                <div class="small text-muted">@(item.PurchasedAtUtc.HasValue ? item.PurchasedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : string.Empty)</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                <form asp-action="DeleteItem" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Удалить товар?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
