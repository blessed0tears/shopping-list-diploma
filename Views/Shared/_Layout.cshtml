@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ShoppingListDiploma.Data.ApplicationDbContext DbContext
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Совместный список покупок</title>
    <script>
        (() => {
            const savedTheme = localStorage.getItem('shopping-list-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg border-bottom">
            <div class="container py-2">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">🛒</span>
                    <span>Совместные покупки</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavbar" class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">О проекте</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Guide">Инструкция</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ShoppingGroups" asp-action="Index">Группы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ShoppingLists" asp-action="Index">Списки</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                            var unreadCount = string.IsNullOrWhiteSpace(currentUserId)
                                ? 0
                                : await DbContext.Notifications.CountAsync(item => item.UserId == currentUserId && !item.IsRead);
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">Уведомления (@unreadCount)</a>
                            </li>
                        }

                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <button type="button" id="themeToggle" class="btn btn-outline-secondary btn-sm theme-toggle" aria-label="Переключить тему">
                                <span class="theme-toggle-icon" aria-hidden="true">🌙</span>
                                <span class="theme-toggle-text">Тёмная тема</span>
                            </button>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="nav-link text-body-secondary">@User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-sm">Выход</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-container">
        <main role="main" class="app-main pb-5">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer py-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 text-body-secondary">
            <span>&copy; @DateTime.Now.Year — «Совместный список покупок»</span>
            <span>Планируйте покупки вместе и без лишней путаницы.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
