@model ShoppingGroupDetailsViewModel

@{
    ViewData["Title"] = Model.Group.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="mb-1">@Model.Group.Name</h1>
        <p class="text-body-secondary mb-0">@(Model.Group.Description ?? "Группа покупок без описания")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.IsCurrentUserOwner)
        {
            <a asp-action="Edit" asp-route-id="@Model.Group.Id" class="btn btn-outline-primary">Редактировать группу</a>
        }
        <a asp-controller="ShoppingLists" asp-action="Create" asp-route-groupId="@Model.Group.Id" class="btn btn-primary">Создать список</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Активные списки</h2>
                <span class="badge text-bg-primary">@Model.ActiveShoppingLists.Count</span>
            </div>
            <div class="card-body">
                @if (!Model.ActiveShoppingLists.Any())
                {
                    <div class="empty-state">В группе пока нет активных списков покупок.</div>
                }
                else
                {
                    <div class="list-group shadow-none">
                        @foreach (var shoppingList in Model.ActiveShoppingLists)
                        {
                            <a asp-controller="ShoppingLists" asp-action="Details" asp-route-id="@shoppingList.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@shoppingList.Name</span>
                                <span class="badge text-bg-secondary">Подробнее</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Архивные списки</h2>
                <span class="badge text-bg-secondary">@Model.ArchivedShoppingLists.Count</span>
            </div>
            <div class="card-body">
                @if (!Model.ArchivedShoppingLists.Any())
                {
                    <div class="empty-state">Архивных списков пока нет.</div>
                }
                else
                {
                    <div class="list-group shadow-none">
                        @foreach (var shoppingList in Model.ArchivedShoppingLists)
                        {
                            <a asp-controller="ShoppingLists" asp-action="Details" asp-route-id="@shoppingList.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@shoppingList.Name</span>
                                <span class="badge text-bg-secondary">Архив</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body">
                <h2 class="h5 mb-0">Участники</h2>
            </div>
            <ul class="list-group list-group-flush shadow-none">
                @foreach (var member in Model.Members)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="fw-semibold">@(member.ApplicationUser.DisplayName ?? member.ApplicationUser.Email)</div>
                            <div class="small text-body-secondary">@member.ApplicationUser.Email — @RoleTitle(member.Role)</div>
                        </div>
                        @if (Model.IsCurrentUserOwner && member.Role != GroupMemberRole.Owner)
                        {
                            <form asp-action="RemoveMember" asp-route-id="@Model.Group.Id" asp-route-memberId="@member.Id" method="post" onsubmit="return confirm('Удалить участника из группы?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </div>

        @if (Model.IsCurrentUserOwner)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-body">
                    <h2 class="h5 mb-0">Пригласить участника</h2>
                </div>
                <div class="card-body">
                    <form asp-action="AddMember" asp-route-id="@Model.Group.Id" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="AddMemberForm.Email" class="form-label"></label>
                            <input asp-for="AddMemberForm.Email" name="Email" class="form-control" />
                            <span class="text-danger" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100">Отправить приглашение</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state mb-4">Управление участниками доступно только владельцу группы.</div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Приглашения в группу</h2>
                <span class="badge text-bg-secondary">@Model.Invitations.Count</span>
            </div>
            <div class="card-body">
                @if (!Model.Invitations.Any())
                {
                    <div class="empty-state">Приглашений пока нет.</div>
                }
                else
                {
                    <div class="list-group shadow-none">
                        @foreach (var invitation in Model.Invitations)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                                <div>
                                    <div class="fw-semibold">@(invitation.InvitedUser.DisplayName ?? invitation.InvitedUser.Email)</div>
                                    <div class="small text-body-secondary">Пригласил: @(invitation.InvitedByUser.DisplayName ?? invitation.InvitedByUser.Email)</div>
                                </div>
                                <span class="badge @InvitationBadge(invitation.Status)">@InvitationStatus(invitation.Status)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string RoleTitle(string role)
    {
        return role == GroupMemberRole.Owner ? "Владелец" : "Участник";
    }

    private static string InvitationStatus(string status)
    {
        return status switch
        {
            GroupInvitationStatus.Accepted => "Принято",
            GroupInvitationStatus.Declined => "Отклонено",
            _ => "Ожидает ответа"
        };
    }

    private static string InvitationBadge(string status)
    {
        return status switch
        {
            GroupInvitationStatus.Accepted => "text-bg-success",
            GroupInvitationStatus.Declined => "text-bg-danger",
            _ => "text-bg-warning"
        };
    }
}
