@model ShoppingGroupIndexViewModel

@{
    ViewData["Title"] = "Группы";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Мои группы покупок</h1>
        <p class="text-muted mb-0">Здесь отображаются только группы, участником которых вы являетесь.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Создать группу</a>
</div>

@if (!Model.Groups.Any())
{
    <div class="empty-state">
        <h2 class="h5">У вас пока нет групп</h2>
        <p class="mb-3">Создайте первую группу, чтобы пригласить участников и вести совместные списки покупок.</p>
        <a asp-action="Create" class="btn btn-primary">Создать первую группу</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var group in Model.Groups)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">@group.Name</h2>
                        <p class="card-text text-muted">@(group.Description ?? "Без описания")</p>
                        <p class="small text-muted mb-3">Участников: @group.Members.Count</p>
                        <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-outline-primary">Открыть</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
